digraph G {
    fontname="Outfit,sans-serif";
    fontsize=12;
    rankdir=LR;
    nodesep=0.5;
    ranksep=0.8;
    bgcolor="#F8FAFC"; // Sleek Light Mode Slate 50 background
    splines=true;
    overlap=false;

    // Default styles
    node [
        fontname="Outfit,sans-serif";
        fontsize=10;
        shape=box;
        style="filled,rounded";
        fillcolor="#FFFFFF"; // White nodes
        fontcolor="#0F172A"; // Slate 900
        color="#CBD5E1"; // Slate 300 border
        penwidth=1.5;
    ];

    edge [
        fontname="Outfit,sans-serif";
        fontsize=9;
        fontcolor="#64748B"; // Slate 500
        color="#94A3B8"; // Slate 400
        arrowsize=0.8;
        penwidth=1.2;
    ];

    // Clusters / Sections
    subgraph cluster_prep {
        label="1. Dataset Pipeline";
        labeljust="l";
        fontcolor="#0284C7"; // Sky 700
        fontsize=11;
        color="#E2E8F0"; // Slate 200
        style="filled,dashed";
        fillcolor="#F0F9FF"; // Sky 50

        xml_source [label="eldamo-data.xml\n(Raw Lexicon)", shape=note, fillcolor="#EEF2FF", color="#C7D2FE", fontcolor="#3730A3"];
        parse_tool [label="xml-to-jsonl\n(Go Utility)", shape=component, fillcolor="#E0F2FE", color="#BAE6FD", fontcolor="#0369A1"];
        jsonl_out [label="eldamo.jsonl.gz\n(Gzipped Embed)", shape=note, fillcolor="#F8FAFC", color="#E2E8F0", fontcolor="#0F172A"];

        xml_source -> parse_tool [label=" Stream parse"];
        parse_tool -> jsonl_out [label=" Compress"];
    }

    subgraph cluster_frontend {
        label="2. Firebase Portal (mithlond-web)";
        labeljust="l";
        fontcolor="#BE185D"; // Pink 700
        fontsize=11;
        color="#E2E8F0";
        style="filled,dashed";
        fillcolor="#FDF2F8"; // Pink 50

        fb_hosting [label="Firebase Hosting\n(www.mithlond.com)", shape=component, fillcolor="#FCE7F3", color="#FBCFE8", fontcolor="#9D174D"];
        auth_spa [label="mcp-auth.html\n(Login & Consent SPA)", shape=window, fillcolor="#FCE7F3", color="#FBCFE8", fontcolor="#9D174D"];
        firebase_auth [label="Firebase Auth\n(Google Sign-In)", shape=ellipse, fillcolor="#FCE7F3", color="#FBCFE8", fontcolor="#9D174D"];

        fb_hosting -> auth_spa [label=" Serves route /mcp-auth"];
        auth_spa -> firebase_auth [label=" Authenticates user"];
    }

    subgraph cluster_mcp_server {
        label="3. Cloud Run Go Backend";
        labeljust="l";
        fontcolor="#047857"; // Emerald 700
        fontsize=11;
        color="#E2E8F0";
        style="filled,dashed";
        fillcolor="#ECFDF5"; // Emerald 50

        loader [label="Data Loader\n(Embed FS)", shape=box, fillcolor="#D1FAE5", color="#A7F3D0", fontcolor="#065F46"];
        index [label="In-Memory Index\n(Trie & Inverted Index)", shape=box, fillcolor="#D1FAE5", color="#A7F3D0", fontcolor="#065F46"];
        oauth_handlers [label="OAuth Handlers\n(Authorize, Token Exchange,\nDCR Register)", shape=component, fillcolor="#D1FAE5", color="#A7F3D0", fontcolor="#065F46"];
        discovery [label="Public Discovery\n(RFC 9728 PRM +\nRFC 8414 Auth Server)", shape=note, fillcolor="#D1FAE5", color="#A7F3D0", fontcolor="#065F46"];
        auth_middleware [label="oauthMiddleware\n(Bearer JWT validation)", shape=shield, fillcolor="#D1FAE5", color="#A7F3D0", fontcolor="#065F46"];
        sse_server [label="SSE Multiplexer\n(/sse & POST /messages)", shape=ellipse, fillcolor="#D1FAE5", color="#A7F3D0", fontcolor="#065F46"];

        loader -> index [label=" Load embedded"];
        index -> sse_server [label=" Serve queries"];
        auth_middleware -> sse_server [label=" Protects route"];
    }

    subgraph cluster_storage {
        label="4. Cloud Firestore";
        labeljust="l";
        fontcolor="#B45309"; // Amber 700
        fontsize=11;
        color="#E2E8F0";
        style="filled,dashed";
        fillcolor="#FEF3C7"; // Amber 50

        firestore_db [label="authorized_users, mcp_auth_codes\n& registered_clients\n(mithlond-services database)", shape=cylinder, fillcolor="#FDE68A", color="#FCD34D", fontcolor="#78350F"];
        ttl_policy [label="5-min TTL Policy\n(Automatic expiry)", shape=component, fillcolor="#FDE68A", color="#FCD34D", fontcolor="#78350F"];

        firestore_db -> ttl_policy [label=" Purges codes"];
    }

    subgraph cluster_client {
        label="5. MCP Clients";
        labeljust="l";
        fontcolor="#6D28D9"; // Violet 700
        fontsize=11;
        color="#E2E8F0";
        style="filled,dashed";
        fillcolor="#F5F3FF"; // Violet 50

        client_domain [label="CIMD Client\n(hosts metadata.json)\ne.g. opencode", shape=folder, fillcolor="#EDE9FE", color="#DDD6FE", fontcolor="#4C1D95"];
        agent [label="DCR Client\n(auto-registers)\ne.g. Gemini Spark", shape=box, fillcolor="#EDE9FE", color="#DDD6FE", fontcolor="#4C1D95"];
    }

    // Connections across sections
    jsonl_out -> loader [label=" Embedded FS", style=dashed, color="#0284C7"];
    fb_hosting -> oauth_handlers [label=" Proxy rewrites\n/api/oauth/**", color="#BE185D"];
    auth_spa -> oauth_handlers [label=" POST ID Token\n+ client_id", color="#BE185D"];
    oauth_handlers -> firestore_db [label=" Manage Users,\nAuth Codes &\nRegistered Clients", color="#B45309"];
    oauth_handlers -> client_domain [label=" CIMD Fetch\n(SSRF-safe GET)", color="#047857", style=dashed];
    client_domain -> fb_hosting [label=" 1. Initiate OAuth\n(CIMD path)", color="#6D28D9"];
    client_domain -> oauth_handlers [label=" 2. Token exchange", color="#6D28D9"];
    client_domain -> auth_middleware [label=" 3. Bearer JWT", color="#6D28D9"];
    agent -> oauth_handlers [label=" 1. DCR Register\n(POST /api/oauth/register)", color="#4C1D95"];
    agent -> fb_hosting [label=" 2. Consent\n(/mcp-auth)", color="#4C1D95"];
    agent -> auth_middleware [label=" 3. Bearer JWT", color="#4C1D95"];
}
